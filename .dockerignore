# The image holds code, configs, tests and the job template. Everything that is
# data, artefact, environment or documentation stays out: data is mounted at
# /app/{data,models,reports} and docs are read in the repository, not the image.
.git
.gitignore
.venv
__pycache__
*.py[cod]
.pytest_cache
.ruff_cache

# Never bake in data or results
data/
models/
reports/
cluster/jobs/

# Not needed to run the pipeline
notebooks/
docs/
site/
mkdocs.yml
references/
